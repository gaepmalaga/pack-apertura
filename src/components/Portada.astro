---
// Portada de la web de un negocio. Hay cuatro composiciones para que dos demos
// del mismo sector no parezcan la misma plantilla con otro color:
//   rotulo  · rótulo enorme a la izquierda, como un letrero de bar
//   cartel  · centrado y enmarcado, como una carta impresa
//   ficha   · título a un lado y una ficha con teléfono y horario al otro
//   banda   · franja del color de la casa a todo lo ancho, con borde de olas
//   sello   · el logo del negocio en el centro, sin repetir el nombre en
//              grande, y un zócalo de festones con su segundo color
//   dividida · texto a la izquierda y, a la derecha, un panel del color de la
//              casa con las etapas de la vida (pensada para clínicas)
//   cine    · a pantalla completa sobre un vídeo en bucle de los platos, con el
//              logo en el centro (para la carta con vídeos)
import { resumenCorto, type HorarioSemana } from '../lib/horario';
import { direccionTexto, medio, url, type Negocio } from '../lib/negocios';

interface Props {
  n: Negocio;
  semana: HorarioSemana;
  tel: string;
  principal: { href: string; texto: string };
  secundario?: { href: string; texto: string };
}
const { n, semana, tel, principal, secundario } = Astro.props;
const tipo = n.tema.portada ?? 'rotulo';
const hayHorario = n.horario.length > 0;
---

{
  tipo === 'cine' ? (
    <section class="portada portada-cine">
      {n.videoPortada ? (
        <video class="cine-fondo" src={medio(n.videoPortada)} poster={medio(n.fotoPortada)} autoplay muted loop playsinline preload="auto" aria-hidden="true" />
      ) : (
        n.fotoPortada && <img class="cine-fondo" src={medio(n.fotoPortada)} alt="" />
      )}
      <div class="envoltura cine-cuerpo">
        {n.logo && <img class="cine-logo" src={url(`/${n.logo}`)} alt="" width="200" height="200" />}
        <h1 class="oculto">{n.nombre}</h1>
        {n.bajoRotulo && <span class="bajo-rotulo">{n.bajoRotulo}</span>}
        <p class="cine-eslogan" data-campo="eslogan">{n.eslogan}</p>
        <div class="datos-portada">
          {hayHorario && (
            <span class="estado" data-estado hidden>
              <span class="punto" aria-hidden="true" />
              <span data-estado-texto />
            </span>
          )}
          <span>{direccionTexto(n)}</span>
        </div>
        <div class="botones">
          <a class="boton principal" href={principal.href}>{principal.texto}</a>
          {secundario && <a class="boton" href={secundario.href}>{secundario.texto}</a>}
        </div>
      </div>
    </section>
  ) : tipo === 'sello' && n.logo ? (
    <section class="portada portada-sello">
      <div class="envoltura sello-cuerpo">
        <img class="sello-logo" src={url(`/${n.logo}`)} alt="" width="360" height="360" />
        <h1 class="oculto">{n.nombre}</h1>
        <p class="sello-eslogan" data-campo="eslogan">{n.eslogan}</p>
        <div class="datos-portada">
          {hayHorario && (
            <span class="estado" data-estado hidden>
              <span class="punto" aria-hidden="true" />
              <span data-estado-texto />
            </span>
          )}
          {hayHorario && <span data-campo="resumen">{resumenCorto(semana)}</span>}
          <span>{direccionTexto(n)}</span>
        </div>
        <div class="botones">
          <a class="boton principal" href={principal.href}>{principal.texto}</a>
          {secundario && <a class="boton" href={secundario.href}>{secundario.texto}</a>}
        </div>
      </div>
      <div class="zocalo" aria-hidden="true" />
    </section>
  ) : tipo === 'dividida' ? (
    <section class="portada portada-dividida">
      <div class="envoltura dividida-rejilla">
        <div class="dividida-texto">
          <h1 class="rotulo">
            {n.rotulo || n.nombre}
            {n.bajoRotulo && <span class="bajo-rotulo">{n.bajoRotulo}</span>}
          </h1>
          <p class="eslogan" data-campo="eslogan">{n.eslogan}</p>
          <div class="datos-portada">
            {hayHorario && (
              <span class="estado" data-estado hidden>
                <span class="punto" aria-hidden="true" />
                <span data-estado-texto />
              </span>
            )}
            {hayHorario && <span data-campo="resumen">{resumenCorto(semana)}</span>}
            <span>{direccionTexto(n)}</span>
          </div>
          <div class="botones">
            <a class="boton principal" href={principal.href}>{principal.texto}</a>
            {secundario && <a class="boton" href={secundario.href}>{secundario.texto}</a>}
          </div>
        </div>
        {(n.etapas?.length ?? 0) > 0 && (
          <a class="dividida-panel" href="#etapas" aria-label="Ver el plan para cada edad">
            <span class="dividida-titulo">Un plan para cada edad</span>
            <ol>
              {n.etapas!.map((e) => (
                <li>
                  <b>{e.titulo}</b>
                  <span>{e.edad}</span>
                </li>
              ))}
            </ol>
          </a>
        )}
      </div>
    </section>
  ) : tipo === 'ficha' ? (
    <section class="portada portada-ficha">
      <div class="envoltura ficha-rejilla">
        <h1 class="rotulo">
          {n.rotulo || n.nombre}
          {n.bajoRotulo && <span class="bajo-rotulo">{n.bajoRotulo}</span>}
        </h1>
        <div class="ficha">
          <p class="eslogan" data-campo="eslogan">{n.eslogan}</p>
          {tel && (
            <a class="ficha-tel" href={tel}>
              <span>Llámanos</span>
              <b data-campo="telefono">{n.contacto.telefono}</b>
            </a>
          )}
          <dl>
            {hayHorario && (
              <div>
                <dt>Hoy</dt>
                <dd>
                  <span class="estado" data-estado hidden>
                    <span class="punto" aria-hidden="true" />
                    <span data-estado-texto />
                  </span>
                </dd>
              </div>
            )}
            {hayHorario && (
              <div>
                <dt>Horario</dt>
                <dd data-campo="resumen">{resumenCorto(semana)}</dd>
              </div>
            )}
            <div>
              <dt>Dónde</dt>
              <dd>{direccionTexto(n)}</dd>
            </div>
          </dl>
          <div class="botones">
            <a class="boton principal" href={principal.href}>{principal.texto}</a>
            {secundario && <a class="boton" href={secundario.href}>{secundario.texto}</a>}
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class={`portada portada-${tipo}${n.logo ? ' con-logo' : ''}`}>
      <div class="envoltura portada-cuerpo">
        {n.logo && <img class="logo-portada" src={url(`/${n.logo}`)} alt={`Logo de ${n.nombre}`} width="360" height="360" />}
        {tipo === 'cartel' && <span class="ornamento" aria-hidden="true">— ✦ —</span>}
        <h1 class="rotulo">
          {n.rotulo || n.nombre}
          {n.bajoRotulo && <span class="bajo-rotulo">{n.bajoRotulo}</span>}
        </h1>
        <p class="eslogan" data-campo="eslogan">{n.eslogan}</p>
        <div class="datos-portada">
          {hayHorario && (
            <span class="estado" data-estado hidden>
              <span class="punto" aria-hidden="true" />
              <span data-estado-texto />
            </span>
          )}
          {hayHorario && <span data-campo="resumen">{resumenCorto(semana)}</span>}
          <span>{direccionTexto(n)}</span>
        </div>
        <div class="botones">
          <a class="boton principal" href={principal.href}>{principal.texto}</a>
          {secundario && <a class="boton" href={secundario.href}>{secundario.texto}</a>}
        </div>
      </div>
      {tipo === 'banda' && (
        <svg class="olas" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 30 C 150 0, 300 60, 450 30 S 750 0, 900 30 S 1100 60, 1200 30 V60 H0 Z" />
        </svg>
      )}
    </section>
  )
}

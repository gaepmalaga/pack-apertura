---
// La web de un negocio, generada entera desde su JSON. Cada bloque aparece solo
// si el negocio tiene datos para él: un bar enseña carta y combos, un taller
// servicios y preguntas, y todos horario, reservas y cómo llegar.
import Demo from '../../../layouts/Demo.astro';
import Portada from '../../../components/Portada.astro';
import Mapa from '../../../components/Mapa.astro';
import { htmlHorario } from '../../../lib/vista-horario';
import {
  negocios,
  telHref,
  waHref,
  mapaHref,
  direccionTexto,
  euros,
  url,
  type Negocio,
} from '../../../lib/negocios';
import { porDia, agrupar, resumenCorto, DIAS, NOMBRE_DIA, formatoTramo } from '../../../lib/horario';

export function getStaticPaths() {
  return negocios.map((negocio) => ({ params: { slug: negocio.slug }, props: { negocio } }));
}

interface Props {
  negocio: Negocio;
}
const { negocio: n } = Astro.props;
const semana = porDia(n.horario);
const grupos = agrupar(semana);
const hayHorario = n.horario.length > 0;
const tel = telHref(n);
const wa = waHref(n, `Hola, vengo de vuestra web. `);
// Una demo sin teléfono publicado enseña igualmente la reserva: al enviar, en vez
// de abrir WhatsApp, muestra el mensaje que le llegaría al negocio.
const reservas = n.reservas?.activas && (n.contacto.whatsapp || n.contacto.telefono || n.demo) ? n.reservas : null;
const reservaMuestra = !n.contacto.whatsapp && !n.contacto.telefono;
const carta = (n.carta ?? []).filter((g) => g.platos.length);
const idGrupo = (t: string) => 'g-' + t.toLowerCase().normalize('NFD').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const titulo = `${n.nombre} · ${n.eslogan.replace(/\.$/, '')}`;
const verCarta = carta.length ? '#carta' : n.servicios?.length ? '#servicios' : '#donde';
// Sin carta ni servicios, lo más útil de la portada es reservar.
const principal =
  verCarta === '#donde' && reservas
    ? { href: '#reservar', texto: reservas.titulo || 'Reservar' }
    : { href: verCarta, texto: carta.length ? 'Ver la carta' : n.servicios?.length ? 'Ver servicios' : 'Cómo llegar' };
const secundario =
  verCarta === '#donde' && reservas
    ? { href: '#donde', texto: 'Cómo llegar' }
    : reservas
      ? { href: '#reservar', texto: reservas.titulo || 'Reservar' }
      : tel
        ? { href: tel, texto: `Llamar · ${n.contacto.telefono}` }
        : undefined;
---

<Demo negocio={n} titulo={titulo} descripcion={n.descripcion}>
  {
    n.demo && (
      <p class="aviso-demo">
        Propuesta de web preparada como ejemplo. No es la web oficial de {n.nombre}. <a href={url('/')}>¿Quieres una así?</a>
      </p>
    )
  }

  <header class="cabecera">
    <div class="envoltura">
      <a class="marca" href="#inicio">{n.rotulo || n.nombre}</a>
      <nav class="menu" aria-label="Secciones">
        {carta.length > 0 && <a href="#carta">Carta</a>}
        {(n.servicios?.length ?? 0) > 0 && <a href="#servicios">Servicios</a>}
        {(n.etapas?.length ?? 0) > 0 && <a href="#etapas">Por edades</a>}
        {reservas && <a href="#reservar">{n.reservas?.personas === false ? 'Cita' : 'Reservar'}</a>}
        {hayHorario && <a href="#donde">Horario</a>}
        <a href="#donde">Cómo llegar</a>
      </nav>
      {tel && <a class="boton principal" href={tel}>Llamar</a>}
    </div>
  </header>

  <main id="inicio">
    <Portada n={n} semana={semana} tel={tel} principal={principal} secundario={secundario} />

    <section class="seccion">
      <div class="envoltura">
        <div class="cabeza">
          <span class="etiqueta">{n.sector === 'bar' ? 'La casa' : n.sector === 'veterinaria' ? 'La clínica' : 'Quiénes somos'}</span>
          <p class="entradilla" style="font-size:20px">{n.descripcion}</p>
        </div>
        {
          (n.destacados?.length ?? 0) > 0 && (
            <div class="rejilla">
              {n.destacados.map((d) => (
                <div class="tarjeta">
                  <h3>{d.titulo}</h3>
                  <p>{d.texto}</p>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </section>

    {
      (n.combos?.length ?? 0) > 0 && (
        <section class="seccion">
          <div class="envoltura">
            <div class="cabeza">
              <span class="etiqueta">Para indecisos</span>
              <h2>Por dónde empezar</h2>
            </div>
            <div class="combos">
              {n.combos.map((c) => (
                <div class="combo">
                  <h3>{c.nombre}</h3>
                  <p>{c.descripcion}</p>
                  {c.precio ? <span class="precio">{euros(c.precio)}</span> : null}
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      carta.length > 0 && (
        <section class="seccion" id="carta">
          <div class="envoltura">
            <div class="cabeza">
              <span class="etiqueta">La carta</span>
              <h2>Qué hay hoy</h2>
              <p class="entradilla">Toca lo que te apetezca y se te queda apuntado, para que no se te olvide nada al pedir.</p>
            </div>
            <nav class="saltos" aria-label="Secciones de la carta">
              {carta.map((g) => (
                <a href={`#${idGrupo(g.titulo)}`}>{g.titulo}</a>
              ))}
            </nav>
            <div class="grupos" data-carta-grupos>
              {carta.map((g) => (
                <div class="grupo" id={idGrupo(g.titulo)}>
                  <h3>{g.titulo}</h3>
                  <ul class="platos">
                    {g.platos.map((p) => (
                      <li>
                        <button type="button" class="plato" data-plato={p.nombre} data-precio={p.precio ?? 0} data-cuantos="0">
                          <span class="n">{p.nombre}</span>
                          <span class="puntos" aria-hidden="true" />
                          <span class="p">{euros(p.precio)}</span>
                          {p.descripcion && <span class="d">{p.descripcion}</span>}
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            {n.cartaNota && <p class="nota-carta">{n.cartaNota}</p>}
          </div>
          <button type="button" class="tira" data-abrir-lista hidden>
            <span data-tira-texto>Tu lista</span>
          </button>
          <dialog class="lista-dialogo" data-lista>
            <div class="lista-cuerpo">
              <h3>Lo que te vas a pedir</h3>
              <ul data-lista-items />
              <div class="lista-total">
                <span>Llevas</span>
                <span data-lista-total>0,00 €</span>
              </div>
              <p class="lista-nota">Esta lista no se manda a ningún sitio: se queda en tu móvil para enseñársela al camarero.</p>
              <div class="botones">
                <button type="button" class="boton" data-borrar-lista>Borrar la lista</button>
                <button type="button" class="boton principal" data-cerrar-lista>Seguir mirando</button>
              </div>
            </div>
          </dialog>
        </section>
      )
    }

    {
      (n.servicios?.length ?? 0) > 0 && (
        <section class="seccion" id="servicios">
          <div class="envoltura">
            <div class="cabeza">
              <span class="etiqueta">Servicios</span>
              <h2>Qué hacemos</h2>
            </div>
            <div class="rejilla">
              {n.servicios.map((s, i) => (
                <div class="tarjeta">
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{s.nombre}</h3>
                  <p>{s.descripcion}</p>
                  {s.precio && <span class="precio">{s.precio}</span>}
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      (n.etapas?.length ?? 0) > 0 && (
        <section class="seccion" id="etapas">
          <div class="envoltura">
            <div class="cabeza">
              <span class="etiqueta">Por edades</span>
              <h2>Qué toca en cada etapa</h2>
            </div>
            <ol class="etapas">
              {n.etapas!.map((e) => (
                <li class="etapa">
                  <span class="etapa-edad">{e.edad}</span>
                  <h3>{e.titulo}</h3>
                  <p>{e.texto}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    {
      reservas && (
        <section class="seccion" id="reservar">
          <div class="envoltura reserva">
            <div class="cabeza">
              <span class="etiqueta">Reservas</span>
              <h2>{reservas.titulo || 'Reservar'}</h2>
              <p class="entradilla">{reservas.texto || 'Dinos cuándo vienes y te lo confirmamos.'}</p>
              {tel && (
                <p class="entradilla">
                  ¿Prefieres hablar? <a href={tel}>Llama al {n.contacto.telefono}</a>.
                </p>
              )}
            </div>
            <form class="formulario" data-reserva data-wa={waHref(n)} data-tel={tel} novalidate>
              {(reservas.opciones?.length ?? 0) > 1 && (
                <fieldset class="paso">
                  <legend>Qué necesitas</legend>
                  <div class="chips">
                    {reservas.opciones!.map((o, i) => (
                      <label class="chip">
                        <input type="radio" name="opcion" value={o} checked={i === 0} />
                        <span>{o}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              )}
              <fieldset class="paso">
                <legend>Qué día</legend>
                <div class="chips desliza" data-dias-reserva />
              </fieldset>
              <fieldset class="paso" data-paso-hora hidden>
                <legend>{hayHorario ? 'A qué hora' : 'Cuándo te viene mejor'}</legend>
                <div class="chips" data-horas-reserva />
              </fieldset>
              {reservas.personas && (
                <fieldset class="paso">
                  <legend>Cuántos sois</legend>
                  <div class="contador">
                    <button type="button" data-menos aria-label="Uno menos">−</button>
                    <output data-personas aria-live="polite">2</output>
                    <button type="button" data-mas aria-label="Uno más">+</button>
                  </div>
                </fieldset>
              )}
              <label>
                Tu nombre
                <input id="r-nombre" name="nombre" autocomplete="name" />
              </label>
              <label>
                Algo más que debamos saber
                <textarea id="r-nota" name="nota" placeholder="Opcional" />
              </label>
              <p class="aviso-reserva" data-aviso-reserva role="alert" hidden />
              <button class="boton principal" type="submit">
                {waHref(n) || reservaMuestra ? 'Enviar por WhatsApp' : 'Llamar para reservar'}
              </button>
              <p class="ayuda">
                {reservaMuestra
                  ? 'En esta muestra no se envía nada: verás el mensaje que le llegaría a la clínica por WhatsApp.'
                  : waHref(n)
                    ? 'Se abre WhatsApp con el mensaje ya escrito. La reserva queda hecha cuando te contestemos.'
                    : 'Te llevamos al teléfono para cerrar la reserva.'}
              </p>
              <div class="muestra-mensaje" data-muestra-mensaje hidden>
                <span class="etiqueta">Así le llegaría por WhatsApp</span>
                <pre data-muestra-texto />
              </div>
            </form>
          </div>
        </section>
      )
    }

    {
      ((n.resenas?.length ?? 0) > 0 || !!n.enlaceResenas) && (
        <section class="seccion">
          <div class="envoltura">
            <div class="cabeza">
              <span class="etiqueta">Opiniones</span>
              <h2>Lo que dicen</h2>
            </div>
            {(n.resenas?.length ?? 0) > 0 && (
              <div class="rejilla">
                {n.resenas.map((r) => (
                  <figure class="tarjeta resena" style="margin:0">
                    {r.estrellas && <span class="estrellas" aria-label={`${r.estrellas} de 5`}>{'★'.repeat(r.estrellas)}</span>}
                    <blockquote style="margin:0">{r.texto}</blockquote>
                    <figcaption class="entradilla">{r.autor}</figcaption>
                  </figure>
                ))}
              </div>
            )}
            {n.enlaceResenas && (
              <p style="margin-top:20px">
                <a class="boton" href={n.enlaceResenas} target="_blank" rel="noopener">
                  Ver todas en Google
                </a>
              </p>
            )}
          </div>
        </section>
      )
    }

    <section class={`seccion donde-${n.tema.mapa ?? 'tarjeta'}`} id="donde">
      <div class="envoltura donde">
        <div class="donde-texto">
          <div class="cabeza">
            <span class="etiqueta">Dónde estamos</span>
            <h2>Cómo llegar</h2>
          </div>
          <p class="direccion">{n.direccion.calle}</p>
          <p class="entradilla">{[n.direccion.cp, n.direccion.zona, n.direccion.ciudad].filter(Boolean).join(' · ')}</p>
          {n.direccion.comoLlegar && <p class="entradilla" style="margin-top:12px">{n.direccion.comoLlegar}</p>}
          <div class="botones" style="margin-top:20px">
            <a class="boton principal" href={mapaHref(n)} target="_blank" rel="noopener">Abrir en Google Maps</a>
            {tel && <a class="boton" href={tel}>{n.contacto.telefono}</a>}
          </div>
        </div>
        <Mapa n={n} />
        {
          hayHorario && (
            <div class="donde-horario">
              <div class="cabeza">
                <span class="etiqueta">Horario</span>
                <h2>Cuándo abrimos</h2>
              </div>
              <div data-vista-horario={n.tema.horario ?? 'filas'} set:html={htmlHorario(n.tema.horario ?? 'filas', semana)} />
              {n.horarioNota && <p class="entradilla" style="margin-top:12px;font-size:15px">{n.horarioNota}</p>}
            </div>
          )
        }
      </div>
    </section>

    {
      (n.faq?.length ?? 0) > 0 && (
        <section class="seccion faq">
          <div class="envoltura">
            <div class="cabeza">
              <span class="etiqueta">Dudas</span>
              <h2>Preguntas rápidas</h2>
            </div>
            {n.faq.map((f) => (
              <details>
                <summary>{f.pregunta}</summary>
                <p>{f.respuesta}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <footer class="envoltura pie">
    <strong>{n.nombre}</strong>
    <span>{direccionTexto(n)}{n.contacto.telefono && <> · <span data-campo="telefono">{n.contacto.telefono}</span></>}</span>
    {n.contacto.instagram && <a href={`https://instagram.com/${n.contacto.instagram}`} target="_blank" rel="noopener">Instagram @{n.contacto.instagram}</a>}
    {n.demo && <span>Web de muestra preparada con datos públicos. No es la web oficial del negocio ni implica relación con él.</span>}
    <a href={url(`/demo/${n.slug}/admin/`)}>{n.demo ? 'Prueba el panel de edición' : 'Panel de edición'}</a>
  </footer>

  <nav class="barra-movil" aria-label="Contacto rápido">
    {tel ? <a href={tel}>Llamar</a> : <a href={verCarta}>{carta.length ? 'Carta' : 'Info'}</a>}
    {wa ? <a href={wa} target="_blank" rel="noopener">WhatsApp</a> : <a href={mapaHref(n)} target="_blank" rel="noopener">Cómo llegar</a>}
    {reservas ? <a class="fuerte" href="#reservar">{n.reservas?.personas === false ? 'Pedir cita' : 'Reservar'}</a> : <a class="fuerte" href={mapaHref(n)} target="_blank" rel="noopener">Llegar</a>}
  </nav>

  <script type="application/json" id="datos-negocio" set:html={JSON.stringify({ slug: n.slug, horario: n.horario, nombre: n.nombre, admin: url(`/demo/${n.slug}/admin/`) })} />
  <script>
    import { porDia, estadoApertura, ahoraEnMadrid } from '../../../lib/horario';
    import { iniciarLista } from '../../../scripts/lista';
    import { iniciarReserva } from '../../../scripts/reserva';
    import { aplicarPrueba } from '../../../scripts/prueba';
    import { marcarHoy } from '../../../lib/vista-horario';

    const datos = JSON.parse(document.getElementById('datos-negocio')!.textContent!);
    aplicarPrueba(datos);
    const semana = porDia(datos.horario);

    function pintarEstado() {
      if (!datos.horario.length) return;
      const { abierto, texto } = estadoApertura(semana);
      document.querySelectorAll<HTMLElement>('[data-estado]').forEach((el) => {
        el.dataset.abierto = String(abierto);
        el.querySelector('[data-estado-texto]')!.textContent = texto;
        el.hidden = false;
      });
      marcarHoy(document, ahoraEnMadrid().dia, semana);
    }
    pintarEstado();
    setInterval(pintarEstado, 60_000);
    iniciarLista(datos.slug);
    iniciarReserva(datos.nombre, datos.horario);
  </script>
</Demo>
